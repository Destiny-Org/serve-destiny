{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Destiny",
  "scopeName": "source.destiny",
  "fileTypes": [
    "dd",
    "ddi"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.destiny",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.destiny",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "include": "#nesting-comment"
        },
        {
          "name": "comment.line.documentation.destiny",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.destiny",
          "match": "//.*$"
        }
      ]
    },
    "nesting-comment": {
      "name": "comment.block.nested.destiny",
      "begin": "/\\+",
      "end": "\\+/",
      "patterns": [
        {
          "include": "#nesting-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.destiny",
          "begin": "r\"",
          "end": "\"[cwd]?"
        },
        {
          "name": "string.quoted.other.raw.destiny",
          "begin": "`",
          "end": "`[cwd]?"
        },
        {
          "name": "string.quoted.double.interpolated.destiny",
          "begin": "i\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "name": "meta.interpolation.destiny",
              "begin": "\\$\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.destiny",
          "begin": "\"",
          "end": "\"[cwd]?",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.token.destiny",
          "begin": "\\bq\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "string.quoted.single.destiny",
          "match": "'(?:\\\\(?:[\\\\'\\\"?abfnrtv0]|x\\h{2}|u\\h{4}|U\\h{8}|&\\w+;)|[^\\\\'])'"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.destiny",
      "match": "\\\\(?:[\\\\'\\\"?abfnrtv0]|x\\h{2}|u\\h{4}|U\\h{8}|[0-7]{1,3}|&\\w+;)"
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.safety.destiny",
          "match": "@(?:safe|trusted|system)\\b"
        },
        {
          "name": "storage.modifier.attribute.destiny",
          "match": "@(?:nogc|property|disable|live|mustuse|standalone|__future)\\b"
        },
        {
          "name": "entity.name.function.decorator.destiny",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.destiny",
          "match": "\\b0[xX][0-9a-fA-F_]+(?:\\.[0-9a-fA-F_]*)?(?:[pP][+-]?[0-9_]+)?[LuUfFi]*\\b"
        },
        {
          "name": "constant.numeric.binary.destiny",
          "match": "\\b0[bB][01_]+[LuU]*\\b"
        },
        {
          "name": "constant.numeric.decimal.destiny",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[LuUfFi]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.destiny",
          "match": "\\b(?:if|else|while|do|for|foreach|foreach_reverse|switch|case|default|break|continue|goto|return|try|catch|finally|throw|with|synchronized|assert|static\\s+if|static\\s+foreach|static\\s+assert)\\b"
        },
        {
          "name": "storage.modifier.destiny",
          "match": "\\b(?:abstract|align|auto|const|deprecated|export|extern|final|immutable|inout|lazy|nothrow|override|package|private|protected|public|pure|ref|scope|shared|static|__gshared|return)\\b"
        },
        {
          "name": "storage.type.destiny",
          "match": "\\b(?:void|bool|byte|ubyte|short|ushort|int|uint|long|ulong|cent|ucent|float|double|real|char|wchar|dchar|string|wstring|dstring|size_t|ptrdiff_t|noreturn)\\b"
        },
        {
          "name": "constant.language.destiny",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "keyword.other.destiny",
          "match": "\\b(?:module|import|class|struct|union|interface|enum|template|mixin|alias|function|delegate|unittest|invariant|this|super|new|delete|cast|typeof|typeid|is|in|out|body|do|version|debug|pragma|asm|__traits|__vector|__parameters|__FILE__|__FILE_FULL_PATH__|__MODULE__|__LINE__|__FUNCTION__|__PRETTY_FUNCTION__)\\b"
        },
        {
          "name": "keyword.operator.destiny",
          "match": "=>|\\.\\.|[-+*/%&|^~!<>=]=?|\\?|:"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|struct|union|interface|enum|template)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.destiny"
            },
            "2": {
              "name": "entity.name.type.destiny"
            }
          }
        },
        {
          "match": "\\b(module|import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.other.destiny"
            },
            "2": {
              "name": "entity.name.namespace.destiny"
            }
          }
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=!?\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.destiny"
        }
      }
    }
  }
}
