{
	"name": "serve-destiny",
	"description": "Microsoft Language Server Protocol library and D Server",
	"license": "MPL-2.0",
	"copyright": "Copyright © 2026, Destiny-Org",
	"dflags": ["-lowmem"],
	"dependencies": {
		"libddoc": "0.8.0",
		"rm-rf": "~>0.1.0",
		"diet-complete": "~>0.0.3",
		"emsi_containers": "0.9.0",
		"serve-destiny:http": "*",
		"serve-destiny:lsp": "*",
		"serve-destiny:serverbase": "*",
		"serve-destiny:workspace-destiny": "*",
		"fuzzymatch": "~>1.0.0",
		"sdlfmt": "~>0.1.1"
	},
	"stringImportPaths": [
		"views"
	],
	"subPackages": [
		"http",
		"protocol",
		"lsp",
		"serverbase",
		"dcd",
		"workspace-destiny"
	],
	"versions-windows": ["RequestsSkipSSL"],
	"configurations": [
		{
			"name": "executable",
			"targetName": "serve-destiny",
			"mainSourceFile": "source/app.d",
			"targetType": "executable"
		},
		{
			"name": "unittest",
			"mainSourceFile": "source/app.d",
			"excludedSourceFiles": [
				"source/app.d",
				"source/served/info.d"
			],
			"dependencies": {
				"silly": "~>1.1.1"
			}
		},
		{
			"name": "unittest-optimized",
			"buildOptions": ["optimize", "debugInfo", "unittests"],
			"mainSourceFile": "source/app.d",
			"excludedSourceFiles": [
				"source/app.d",
				"source/served/info.d"
			],
			"dependencies": {
				"silly": "~>1.1.1"
			}
		}
	]
}
